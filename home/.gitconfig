[include]
  path = ~/.config/catppuccin.gitconfig

[user]
  name = Yahia
  email = yn7599@gmail.com

[core]
  editor = nvim
  pager = git delta

[interactive]
  diffFilter = git delta --color-only

[color]
  ui = true

[init]
  defaultBranch = main

[help]
  autocorrect = 1

[alias]
  s = status
  a = add  .
  c = commit -m
  cc = commit --amend -m
  ac = !git a && git c
  undo = reset --soft HEAD^
  p = push
  pr = pull --rebase
  ls = log --graph --decorate --pretty=format:'%C(3)%h %C(4)[%cn] %C(8)%s %C(1)%d'
  alias = !git config -l | rg alias | cut -c 7- | sed 's/=/\t/'
  delta = !delta --features "$(theme)"-theme

[protocol "file"]
  allow = always

[delta "dark-theme"]
  dark = true
  features = catppuccin-mocha

[delta "light-theme"]
  light = true
  features = catppuccin-latte

[delta]
  features = decorations
