layout {
    background-color "transparent"

    focus-ring {
        active-color   "#82d5c8"
        inactive-color "#899390"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#82d5c8"
        inactive-color "#899390"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#82d5c8"
        inactive-color "#899390"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#82d5c880"
    }
}

/-recent-windows {
    highlight {
        active-color   "#005048"
        urgent-color   "#ffb4ab"
    }
}